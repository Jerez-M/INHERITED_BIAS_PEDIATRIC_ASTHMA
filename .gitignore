.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Ignore everything inside data subfolders
data/raw/*
data/processed/*

# Keep the folders themselves
!data/raw/.gitkeep
!data/processed/.gitkeep

# Ignore everything inside outputs
outputs/*

# Keep desired output subfolders
!outputs/figures/
!outputs/models/
!outputs/tables/

# Ignore contents of output subfolders
outputs/figures/*
outputs/models/*
outputs/tables/*

# Keep placeholder files
!outputs/figures/.gitkeep
!outputs/models/.gitkeep
!outputs/tables/.gitkeep